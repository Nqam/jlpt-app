{
  "name": "jlpt-app",
  "version": "1.3.0",
  "private": true,
  "description": "こつこつ (Kotsukotsu) — приложение для изучения японского по программе JLPT (N5–N4): интервальные повторения, грамматика, кандзи, слова, тексты, вступительный тест.",
  "author": "Nqam <am200641@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:desktop": "npm run build-content && npm run build && electron-builder --win --dir",
    "build:desktop:installer": "npm run build-content && npm run build && electron-builder --win",
    "build-content": "tsx scripts/build-content/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p shells/electron/tsconfig.json --noEmit",
    "pretest": "npm run build-content",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "make-icon": "tsx scripts/make-icon.ts"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.2",
    "yaml": "^2.6.0"
  }
}
